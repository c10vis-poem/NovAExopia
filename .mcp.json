{
  "mcpServers": {
    "claw": {
      "command": "sh",
      "args": [
        "plugins/claw-mcp/bin/claw-mcp"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": "plugins/claw-mcp"
      }
    },
    "chrome-devtools": {
      "command": "sh",
      "args": [
        "plugins/claw-mcp/bin/chrome-devtools"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": "plugins/claw-mcp"
      }
    },
    "jev-rea-mcp": {
      "command": "python3",
      "args": [
        "-I",
        "plugins/nvaex-jev-core/mcp/jev-rea-mcp/server.py"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": "plugins/nvaex-jev-core",
        "TYPESAFE_API_KEY": "${TYPESAFE_API_KEY:-}"
      }
    },
    "dumbass-memory": {
      "command": "python3",
      "args": [
        "-I",
        "plugins/nvaex-memory/mcp/dumbass-memory-mcp/server.py"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": "plugins/nvaex-memory",
        "DUMBASS_DATA_DIR": "~/.nvaex/memory"
      }
    },
    "rea-mcp": {
      "command": "python3",
      "args": [
        "-I",
        "plugins/nvaex-rea-forge/mcp/rea-mcp/server.py"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": "plugins/nvaex-rea-forge"
      }
    },
    "burn-mcp": {
      "command": "python3",
      "args": [
        "-I",
        "plugins/nvaex-burn/mcp/burn-mcp/server.py"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": "plugins/nvaex-burn"
      }
    }
  }
}
