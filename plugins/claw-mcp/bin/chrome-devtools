#!/bin/sh
# Starts the operator's Chrome DevTools fork against phone Chrome (CDP on 127.0.0.1). Same kill switch as claw.
[ -e "$HOME/.nvaex-hooks-off" ] || [ -e "$HOME/.claude/state/off/claw-mcp" ] && exit 0
D="${CLAW_DEVTOOLS_DIR:-$HOME/repos/NvAEx-chrome-devtools-mcp}"
B="$D/build/src/bin/chrome-devtools-mcp.js"
[ -f "$B" ] || { echo "chrome-devtools: $B missing; build the fork (npm ci, npm run build, node scripts/post-build.ts)" >&2; exit 1; }
exec node "$B" --browserUrl "http://127.0.0.1:${CDP_PORT:-9222}" --no-usage-statistics --no-performance-crux "$@"
