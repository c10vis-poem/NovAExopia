{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact",
        "hooks": [ { "type": "command", "timeout": 10,
          "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory.py\" snapshot" } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "timeout": 10,
          "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory.py\" export" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "timeout": 10,
          "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory.py\" nudge" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "timeout": 15,
          "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory.py\" recap" } ] }
    ]
  }
}
